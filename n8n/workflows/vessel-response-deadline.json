{
  "id": "rtms-vessel-timeout",
  "name": "RTMS - 02. Vessel Timeout (24h) & Aggregation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "schedule-trigger-15m",
      "name": "Schedule Trigger (Every 15m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:3001/api/v1/internal/jobs/vessel-request-timeout",
        "options": {}
      },
      "id": "trigger-vessel-timeout-job",
      "name": "Run Vessel Request Timeout Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-transitioned-count",
              "leftValue": "={{ $json.data.transitioned_to_customer_selection }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-had-selection-updates",
      "name": "Has Bookings Ready for Customer?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Schedule Trigger (Every 15m)": {
      "main": [
        [
          {
            "node": "Run Vessel Request Timeout Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Vessel Request Timeout Job": {
      "main": [
        [
          {
            "node": "Has Bookings Ready for Customer?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
