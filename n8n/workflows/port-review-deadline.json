{
  "id": "rtms-port-deadline",
  "name": "RTMS - 01. Port Review Reminder & Deadline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger (Every 2h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://backend:3001/api/v1/bookings?booking_status=PENDING_PORT_REVIEW",
        "options": {}
      },
      "id": "get-pending-bookings",
      "name": "Get Pending Port Review Bookings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-has-bookings",
              "leftValue": "={{ $json.data.items.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-bookings-exist",
      "name": "Has Pending Bookings?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:3001/api/v1/internal/jobs/send-reminder",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"booking_ids\": {{ $json.data.items.map(b => b.booking_id) }},\n  \"reminder_target_context\": \"PORT_REVIEW_PENDING\"\n}",
        "options": {}
      },
      "id": "trigger-reminder-job",
      "name": "Trigger Backend Reminder Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 240]
    }
  ],
  "connections": {
    "Schedule Trigger (Every 2h)": {
      "main": [
        [
          {
            "node": "Get Pending Port Review Bookings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Pending Port Review Bookings": {
      "main": [
        [
          {
            "node": "Has Pending Bookings?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Pending Bookings?": {
      "main": [
        [
          {
            "node": "Trigger Backend Reminder Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
